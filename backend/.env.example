PORT=5000
# Local PostgreSQL. Create the database first:  createdb lms
# On AWS use the RDS endpoint and set DB_SSL=true.
# If the password has special characters, URL-encode them.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lms
DB_SSL=false
JWT_SECRET=change-me-to-any-long-random-string
# Leave S3_BUCKET empty to store uploads in backend/uploads.
# Set it (plus AWS credentials/region) to use S3 with no code changes.
S3_BUCKET=
AWS_REGION=us-east-1
